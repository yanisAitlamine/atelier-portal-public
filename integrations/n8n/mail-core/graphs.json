            "tail": "\nconst prev=$('Préparer requête').item;let s=prev.json.state,binary={...(prev.binary||{})};try{const data=await this.helpers.getBinaryDataBuffer(0,'download');s=intake.consumeBinary(s,data);const m=s.current.meta;binary['source_'+m.id]={...$input.first().binary.download,fileName:m.id+(m.mimeType==='application/pdf'?'.pdf':m.mimeType==='image/png'?'.png':m.mimeType==='image/jpeg'?'.jpg':m.mimeType==='image/webp'?'.webp':'.txt'),mimeType:m.mimeType};if(s.route==='PDF')binary.data=binary['source_'+m.id];}catch(e){s=intake.fail(s,/^[A-Z_]+$/.test(e.message)?e.message:'DOWNLOAD_FAILED');}return [{json:{state:s,route:s.route},binary,pairedItem:{item:0}}];"
